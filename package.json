{
  "name": "flow-dashboard",
  "private": true,
  "scripts": {
    "predev": "npm run data:emit",
    "dev": "next dev",
    "build": "node scripts/check-root-logic.mjs && npm run data:emit && next build",
    "data:emit": "node --experimental-strip-types --import ./scripts/register-typescript.mjs scripts/emit-flow-data.mjs",
    "verify:data": "node --experimental-strip-types --import ./scripts/register-typescript.mjs scripts/verify-data.mjs && npm run verify:pay",
    "verify:pay": "node --experimental-strip-types --import ./scripts/register-typescript.mjs scripts/verify-pay.mjs",
    "start": "next start"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "19.2.18",
    "esbuild": "^0.28.2",
    "react-test-renderer": "^19.2.8",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
